{
  "name": "flickphp/laravel",
  "description": "Laravel integration for Flick form library.",
  "homepage": "https://github.com/flickphp/laravel",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "flick",
    "laravel",
    "form",
    "php",
    "form builder"
  ],
  "authors": [
    {
      "name": "Tim Gavin",
      "homepage": "https://github.com/timgavin"
    }
  ],
  "require": {
    "php": "^8.3",
    "flickphp/flick": "^1.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.0|^5.0",
    "laravel/pint": "^1.30",
    "orchestra/testbench": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Flick\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flick\\Laravel\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Flick\\Laravel\\FlickServiceProvider"
      ],
      "aliases": {
        "Flick": "Flick\\Laravel\\Facades\\Flick"
      }
    }
  },
  "scripts": {
    "format": "vendor/bin/pint",
    "test": "./vendor/bin/pest"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
